# ---------------------------------------------------------------------------
# Gravitas Majlis — environment template
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# The repository is public: a key committed here is a key that is published.
# ---------------------------------------------------------------------------

# Anthropic API key for the comprehension assistant.
# Set this in the hosting platform's secret store in production, not in a file.
ANTHROPIC_API_KEY=sk-ant-...

# Models. Override if the defaults are retired.
ASSISTANT_MODEL=claude-sonnet-4-6
CLASSIFIER_MODEL=claude-haiku-4-5

# --- What this installation has attached ------------------------------------
#
# Both default to nothing, and nothing is a complete installation. A Shariah
# board inside a bank runs with neither: the record, deliberation, evidence,
# operative terms, voting and export all work with no chain and no assistant.
#
# MAJLIS_ENFORCEMENT   none | gravitas-registry
#   What carries out what the board decides. Nothing here ever performs
#   enforcement — an adapter reports what the enforcing system currently says,
#   so a board can see whether what runs matches what it approved.
#   Left unset, it is inferred from POLICY_REGISTRY_ADDRESS so an installation
#   configured before this existed does not lose its chain read on upgrade.
#
# MAJLIS_ASSISTANT     off | anthropic
#   The comprehension assistant sends the text of a member's question to a model
#   run by someone else. Some institutions forbid that outright, and a board's
#   deliberation is among the most sensitive text an institution holds.
#   Left unset, it is inferred from ANTHROPIC_API_KEY. Set it to off explicitly
#   where policy requires the guarantee rather than the default.
#
# MAJLIS_ENFORCEMENT=none
# MAJLIS_ASSISTANT=off

# --- Limits -----------------------------------------------------------------
# The assistant endpoint sits behind the same authentication as everything else;
# only /api/health is exempt. Authentication says who may call it, not how often,
# so these limits are what stands between an authenticated caller and the API
# budget. Do not deploy without them.
RATE_LIMIT_PER_IP=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_PER_DAY=2000
# Hard ceiling on estimated model spend per UTC day, in USD. The endpoint stops
# when this is reached; it does not warn and continue.
ASSISTANT_DAILY_USD_CAP=20
# Estimated cost of one question (classifier call + assistant call).
ASSISTANT_USD_PER_QUESTION=0.02

# --- who is at the keyboard --------------------------------------------------
# One credential per member, so a vote can be attributed to whoever cast it.
# Roles: signatory (votes and objects), advisory and liaison (deliberate only),
# observer (reads).
#
# Generate a line, typing the password at a prompt rather than passing it as an
# argument, which would land in the shell history:
#   npm run member -w server -- member-a signatory
#
# A password identifies. It does not sign. Stage Three is where the vote becomes
# a signature under a key the scholar controls.
MAJLIS_MEMBERS=

# The shared credential. It cannot say which member is here, so a request
# authenticated with it is an observer: it reads, and writes nothing. Set
# MAJLIS_MEMBERS instead once the board is real. Generate the password with:
#   openssl rand -base64 18
BASIC_AUTH_USER=board
BASIC_AUTH_PASSWORD=

# --- The record -------------------------------------------------------------
# Where the board record is kept. A JSON file, written atomically.
#
# Leave it unset and the record lives in memory and dies with the process, which
# is right for a development run and wrong for anything else. In production the
# server refuses to start without it rather than silently forgetting decisions.
#
# On a host with an ephemeral filesystem this must point at a mounted volume.
# A path in the working directory looks like it works and loses everything on
# the next deploy.
MAJLIS_DB=./data/majlis.json

# --- Server -----------------------------------------------------------------
PORT=4000

# --- Chain ------------------------------------------------------------------
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Deployed Gravitas contracts (Arbitrum Sepolia).
# Redeployed and verified on Arbiscan, 23 August 2026. The bytecode at these
# addresses is built from the source in this repository. See docs/DEPLOYMENTS.md.
POLICY_REGISTRY_ADDRESS=0x6f3bfb896DD9964C9c05dA88692bDf1b1b2C3F23
TELEPORT_V3_ADDRESS=0x6702C2CE6eD58ca3934eBBd785CaC1De8DCd85B4

# Set to "true" to serve seed data only and never touch the chain.
OFFLINE_MODE=false
